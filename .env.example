# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored. Never put real credentials in this file or any tracked file.
# data-extraction-scripts/config.py loads .env; variables already exported win.

# ---------------------------------------------------------------- extraction
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# NASA Earthdata login, for AppEEARS (NDVI, land cover): https://urs.earthdata.nasa.gov/
EARTHDATA_USER=
EARTHDATA_PASS=
# Google Cloud project registered for Earth Engine (WDPA monthly history).
# Also run `earthengine authenticate` once on your machine.
EE_PROJECT=

# ---------------------------------------------------------------- warehouse
# Optional. The jobs in controllers/ default to the local Docker database
# (localhost:5432, fire_dwh, dwh_admin, admin123 from docker-compose.yml).
# Uncomment only to point them elsewhere: an empty value would override the default.
# DWH_HOST=localhost
# DWH_PORT=5432
# DWH_DB=fire_dwh
# DWH_USER=dwh_admin
# DWH_PASSWORD=your-database-password

# ---------------------------------------------------------------- airflow
# Optional. Login for the Airflow UI at http://localhost:8080 (default airflow / airflow).
# AIRFLOW_ADMIN_USER=airflow
# AIRFLOW_ADMIN_PASSWORD=your-airflow-password
# Memory for the heavy ETL jobs when Airflow runs them (controllers/db_limits.py).
# docker-compose.yml defaults: 64MB / 256MB / 4, safe on a 4 GB Docker VM. Raise
# them if Docker Desktop has more memory. Manual runs from the host ignore these
# lines and use 256MB / 1GB / 8 unless the variables are exported in the shell.
# DWH_WORK_MEM=64MB
# DWH_MAINTENANCE_WORK_MEM=256MB
# DWH_PARALLEL_WORKERS=4
